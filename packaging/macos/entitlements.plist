<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Pdfcraft. Deliberately empty: the app is pure Rust,
     loads no unsigned code, needs no JIT, and is not sandboxed (it opens files by path, from the
     command line and drag-and-drop). Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
    <!-- Fork: the PKCS #11 modules that sign with token certificates (Certisign desktopID,
         eToken) are signed by their vendors, and the hardened runtime only loads code signed by
         Apple or by this app's team. Without this, dlopen refuses them ("different Team IDs"). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
